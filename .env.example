# Resend API key — get from https://resend.com/api-keys after verifying
# your sending domain's DKIM / SPF / DMARC records in Namecheap (see handbook 5.1).
RESEND_API_KEY=

# Cloudflare R2 (for high-res image storage, if wired up later).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
